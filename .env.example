# ==============================================================================
# SUPABASE CONFIGURATION (Visitor Analytics & Contact Messages)
# ==============================================================================
# 1. Sign up at https://supabase.com and create a free project.
# 2. In your Supabase Dashboard, navigate to the SQL Editor.
# 3. Paste and run the entire script found in `supabase/schema.sql`.
# 4. Under Project Settings -> API, copy your Project URL and anon/public API Key.
# 5. Paste them below:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ==============================================================================
# OPTIONAL: DIRECT EMAIL NOTIFICATION SERVICES (Contact Form)
# ==============================================================================

# EmailJS Configuration (Optional for instant email forwarding)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Web3Forms Access Key (Optional fallback)
VITE_WEB3FORMS_KEY=
